# Vercel 프로젝트 Settings → Environment Variables 에 입력하세요.
# 이 파일은 예시이며, 실제 키는 절대 깃에 커밋하지 마세요. (.gitignore에 .env 포함됨)

# 운영 대표 주소. 결제·관리자·배송사진·OAuth 링크 생성에 공통 사용.
PUBLIC_BASE_URL=https://floweranbu.co.kr

# ── Claude API (URL/텍스트 파싱용) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── 토스페이먼츠 ──
# 시크릿 키 (서버 전용 — 절대 프론트에 넣지 말 것)
# 테스트: test_sk_... / 라이브: live_sk_...
TOSS_SECRET_KEY=test_sk_...

# ── 솔라피(SOLAPI) 문자/알림톡 ──
# https://solapi.com 가입 후 발급. 미설정 시 알림만 생략되고 결제는 정상 동작.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=     # 솔라피에 사전 등록한 발신번호 (숫자만, 예: 0312000000)

# ── 사장님(어머니) 알림 수신 번호 (숫자만) ──
OWNER_PHONE_1=
OWNER_PHONE_2=

# ── 네이버 로그인 (Supabase 미지원 → 백엔드 OAuth: api/naver-login·naver-callback) ──
# https://developers.naver.com 앱 등록 후 발급. Callback URL: https://floweranbu.co.kr/api/naver-callback
# 3개 다 넣고 재배포하면 로그인 모달에 '네이버 버튼'이 자동으로 나타납니다. (SETUP-AUTH.md 2번 참조)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# ↑ 네이버 콜백은 아래 SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY(갤러리와 동일 키)도 함께 필요.

# ── 갤러리 직접 업로드 (관리자 /admin 페이지 → api/gallery-add.js) ──
# Supabase 프로젝트 → Project Settings → API 에서 확인.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # service_role 키 (서버 전용 — 절대 프론트/깃에 넣지 말 것)
ADMIN_PASSWORD=               # 부모님이 /admin 에서 입력할 업로드 비밀번호 (직접 정하세요)
# ※ SUPABASE_URL + anon(public) 키는 supabase-config.js 에도 넣어야 카탈로그가 사진을 읽어옵니다.

# ── 관리자 계정 전환 (1차 안전 묶음) ──
# dual: 새 Supabase 관리자 로그인 + 예전 비밀번호를 잠시 함께 허용
# jwt : 아래 UID/email allowlist의 Supabase 로그인만 허용(전환 확인 후 권장)
ADMIN_AUTH_MODE=dual
ADMIN_OWNER_IDS=              # Supabase auth.users UUID, 쉼표로 여러 명
ADMIN_STAFF_IDS=              # 주문/사진 운영만 가능한 직원 UUID
ADMIN_OWNER_EMAILS=           # UID 등록 전 임시 이전용
ADMIN_STAFF_EMAILS=

# ── 결제 준비 원장·배송사진 링크 (1차 안전 묶음) ──
# supabase-first-bundle.sql 적용 후 1로 바꾸면 준비 원장 없이는 결제창을 열지 않음.
PAYMENT_INTENTS_REQUIRED=0
# 공개 결제 준비 API에서 IP 원문 대신 HMAC fingerprint를 만드는 전용 랜덤키.
PAYMENT_RATE_LIMIT_SECRET=
# 기사 사진 업로드 링크 전용 랜덤 시크릿. 미설정 때는 전환 호환용으로 CRON_SECRET을 사용.
PHOTO_UPLOAD_SECRET=
# solapi: 자동 문자 / manual: 사장님 텔레그램·관리화면에서 고객 링크 전달
PHOTO_NOTICE_MODE=manual
