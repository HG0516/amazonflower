{
  "version": 2,
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "api/_corp/**"
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/admin-:page",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/delivery-photo.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/deliver.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "xn--49000-te3tz2rfwu.kr" }],
      "destination": "https://floweranbu.co.kr/$1?utm_source=domain&utm_medium=49000kr",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.xn--49000-te3tz2rfwu.kr" }],
      "destination": "https://floweranbu.co.kr/$1?utm_source=domain&utm_medium=49000kr",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "amazonflower.co.kr" }],
      "destination": "https://floweranbu.co.kr/$1?utm_source=domain&utm_medium=amazonflower",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.amazonflower.co.kr" }],
      "destination": "https://floweranbu.co.kr/$1?utm_source=domain&utm_medium=amazonflower",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/admin-home",
      "destination": "/admin-home.html",
      "permanent": false
    },
    {
      "source": "/admin-order",
      "has": [
        {
          "type": "query",
          "key": "order",
          "value": "(?<orderId>[A-Za-z0-9._-]{4,64})"
        }
      ],
      "destination": "/admin-order.html?order=:orderId",
      "permanent": false
    },
    {
      "source": "/admin-order",
      "destination": "/admin-order.html",
      "permanent": false
    },
    {
      "source": "/admin-orders",
      "destination": "/admin-orders.html",
      "permanent": false
    },
    {
      "source": "/admin-pay",
      "destination": "/admin-pay.html",
      "permanent": false
    },
    {
      "source": "/admin-products",
      "destination": "/admin-products.html",
      "permanent": false
    },
    {
      "source": "/admin-setup",
      "destination": "/admin-setup.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/s/:pc",
      "destination": "/s/:pc.html"
    },
    {
      "source": "/c/:id",
      "destination": "/api/order-meta?card=:id"
    },
    {
      "source": "/funeral/:name",
      "destination": "/funeral/:name.html"
    },
    {
      "source": "/bugo/make",
      "destination": "/card-make.html"
    },
    {
      "source": "/wedding-card/make",
      "destination": "/card-make.html"
    },
    {
      "source": "/wedding-card",
      "destination": "/wedding-card.html"
    },
    {
      "source": "/bugo",
      "destination": "/bugo.html"
    },
    {
      "source": "/my",
      "destination": "/my.html"
    },
    {
      "source": "/ask",
      "destination": "/ask.html"
    },
    {
      "source": "/p/:code",
      "destination": "/p.html"
    }
  ]
}
